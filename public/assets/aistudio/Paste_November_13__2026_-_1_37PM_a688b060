7.3 State machine
// src/components/respondent/useFlow.ts
import { create } from 'zustand';

type Step =
  | 'welcome' | 'practice-intro' | 'practice-q' | 'permission'
  | 'practice-record' | 'ready' | 'question' | 'review' | 'done';

type Answer = { optionIds?: string[]; recordingKey?: string };

interface Flow {
  step: Step;
  index: number;                    // current real question
  answers: Record<string, Answer>;  // keyed by question id
  go: (s: Step) => void;
  answer: (qid: string, a: Answer) => void;
  next: (total: number) => void;
  back: () => void;
  jumpTo: (i: number) => void;
}

export const useFlow = create<Flow>((set, get) => ({
  step: 'welcome',
  index: 0,
  answers: {},
  go: (step) => set({ step }),
  answer: (qid, a) => set((s) => ({ answers: { ...s.answers, [qid]: a } })),
  next: (total) => {
    const { index } = get();
    if (index + 1 >= total) set({ step: 'review' });
    else set({ index: index + 1, step: 'question' });
  },
  back: () => set((s) => ({ index: Math.max(0, s.index - 1) })),
  jumpTo: (i) => set({ index: i, step: 'question' }),
}));
