5. Database schema (Supabase / Postgres)
create extension if not exists pgcrypto;

create table organisations (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  created_at timestamptz default now()
);

create table profiles (
  id uuid primary key references auth.users on delete cascade,
  organisation_id uuid references organisations,
  full_name text,
  role text not null default 'creator' check (role in ('owner','creator','reviewer'))
);

create table surveys (
  id uuid primary key default gen_random_uuid(),
  organisation_id uuid not null references organisations,
  title text not null,
  slug text unique not null,
  status text not null default 'draft' check (status in ('draft','published','closed')),
  intro_video_path text,
  outro_video_path text,
  created_by uuid references profiles,
  created_at timestamptz default now()
);

create table questions (
  id uuid primary key default gen_random_uuid(),
  survey_id uuid not null references surveys on delete cascade,
  position int not null,
  kind text not null check (kind in ('single','multi','signed')),
  required boolean default true,
  video_path text not null,
  label text,                    -- internal note for creators, never shown to students
  unique (survey_id, position)
);

create table options (
  id uuid primary key default gen_random_uuid(),
  question_id uuid not null references questions on delete cascade,
  position int not null,
  video_path text not null,
  thumb_path text,
  label text                     -- for exports, for example 'Yes'
);

create table sessions (
  id uuid primary key default gen_random_uuid(),
  survey_id uuid not null references surveys,
  status text not null default 'in_progress' check (status in ('in_progress','completed')),
  started_at timestamptz default now(),
  completed_at timestamptz
);

create table responses (
  id uuid primary key default gen_random_uuid(),
  session_id uuid not null references sessions on delete cascade,
  question_id uuid not null references questions,
  option_ids uuid[],             -- single and multi questions
  video_path text,               -- signed questions
  transcript text,               -- written by a reviewer later
  reviewed boolean default false,
  unique (session_id, question_id)
);

-- Storage buckets
-- question-media: survey videos and thumbnails (read via signed URLs)
-- response-videos: students' recordings (private, creators of that organisation only)
Row-level security rules to apply:
• Creators can read and write only rows whose survey belongs to their organisation.
• Respondents never touch tables directly. All respondent actions go through the three API routes in section 8, using the service role key on the server.
• The response-videos bucket is private. Reviewers get short-lived signed URLs only.
Acceptance check: two test creators in different organisations cannot see each other's surveys or recordings.
