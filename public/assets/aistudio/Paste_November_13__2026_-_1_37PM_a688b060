7.5 Sign recording
Use MediaRecorder. Ask for 720p at 30fps, because sign language needs smooth, clear motion.
// src/lib/recorder.ts
import { useRef, useState, useCallback } from 'react';

type Phase = 'idle' | 'asking' | 'denied' | 'countdown' | 'recording' | 'review';

export function useSignRecorder(maxSeconds = 120) {
  const [phase, setPhase] = useState<Phase>('idle');
  const [count, setCount] = useState(3);
  const [blob, setBlob] = useState<Blob | null>(null);
  const stream = useRef<MediaStream | null>(null);
  const rec = useRef<MediaRecorder | null>(null);
  const chunks = useRef<Blob[]>([]);

  const open = useCallback(async () => {
    setPhase('asking');
    try {
      stream.current = await navigator.mediaDevices.getUserMedia({
        video: { width: 1280, height: 720, frameRate: 30, facingMode: 'user' },
        audio: false,
      });
      setPhase('idle');
      return stream.current;
    } catch {
      setPhase('denied');
      return null;
    }
  }, []);

  const start = useCallback(() => {
    if (!stream.current) return;
    setPhase('countdown');
    let n = 3;
    setCount(n);
    const t = setInterval(() => {
      n -= 1;
      setCount(n);
      if (n === 0) {
        clearInterval(t);
        chunks.current = [];
        const mime = MediaRecorder.isTypeSupported('video/webm;codecs=vp9')
          ? 'video/webm;codecs=vp9' : 'video/mp4';
        rec.current = new MediaRecorder(stream.current!, { mimeType: mime, videoBitsPerSecond: 2_500_000 });
        rec.current.ondataavailable = (e) => e.data.size && chunks.current.push(e.data);
        rec.current.onstop = () => { setBlob(new Blob(chunks.current, { type: mime })); setPhase('review'); };
        rec.current.start(1000);
        setPhase('recording');
        setTimeout(() => rec.current?.state === 'recording' && rec.current.stop(), maxSeconds * 1000);
      }
    }, 1000);
  }, [maxSeconds]);

  const stop = useCallback(() => rec.current?.stop(), []);
  const discard = useCallback(() => { setBlob(null); setPhase('idle'); }, []);
  const close = useCallback(() => stream.current?.getTracks().forEach((t) => t.stop()), []);

  return { phase, count, blob, stream, open, start, stop, discard, close };
}
The recording screen must show: the question video on one side, the live self-view on the other (mirrored), a large red Record button, a big countdown, and a Stop button. The review state offers three clear buttons with icons: Keep (teal), Record again (outline), Delete (outline, red icon). Nothing is stored on the server until the student reaches the review list and finishes.
